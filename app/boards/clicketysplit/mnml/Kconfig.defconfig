if BOARD_CLICKETY_SPLIT_MNML_3X6_LEFT

config ZMK_KEYBOARD_NAME
    default "MNML v2.13"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_CLICKETY_SPLIT_MNML_3X6_LEFT

if BOARD_CLICKETY_SPLIT_MNML_3X6_LEFT || BOARD_CLICKETY_SPLIT_MNML_3X6_RIGHT

config BOARD
    default "clickety_split_mnml_3x6"

config ZMK_SPLIT
    default y

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

endif # BOARD_CLICKETY_SPLIT_MNML_3X6_LEFT || BOARD_CLICKETY_SPLIT_MNML_3X6_RIGHT
