#include <physical_layouts.dtsi>

/ {
    mnml_3x6_layout: mnml_3x6_layout {
        compatible = "zmk,physical-layout";
        display-name = "MNML 3x6";

        /*
         * Physical switch geometry derived from the MNML 3x6 STEP model.
         *
         * Units:
         *   w, h, x, y: centi-keyunits (100 = 1U)
         *   rot:         centidegrees
         *
         * The two halves use a fixed 30 mm visual separation for Studio
         * rendering. This is not a physical constraint on the split keyboard.
         *
         * Keys are listed in the same order as default_transform.
         */
        keys  //                     w   h     x    y      rot    rx    ry

            // Row 0
            = <&key_physical_attrs 100 100     0   21        0     0     0>
            , <&key_physical_attrs 100 100   100   21        0     0     0>
            , <&key_physical_attrs 100 100   200    8        0     0     0>
            , <&key_physical_attrs 100 100   300    0        0     0     0>
            , <&key_physical_attrs 100 100   400    8        0     0     0>
            , <&key_physical_attrs 100 100   500   17        0     0     0>

            , <&key_physical_attrs 100 100  1000   17        0     0     0>
            , <&key_physical_attrs 100 100  1100    8        0     0     0>
            , <&key_physical_attrs 100 100  1200    0        0     0     0>
            , <&key_physical_attrs 100 100  1300    8        0     0     0>
            , <&key_physical_attrs 100 100  1400   21        0     0     0>
            , <&key_physical_attrs 100 100  1500   21        0     0     0>

            // Row 1
            , <&key_physical_attrs 100 100     0  121        0     0     0>
            , <&key_physical_attrs 100 100   100  121        0     0     0>
            , <&key_physical_attrs 100 100   200  108        0     0     0>
            , <&key_physical_attrs 100 100   300  100        0     0     0>
            , <&key_physical_attrs 100 100   400  108        0     0     0>
            , <&key_physical_attrs 100 100   500  117        0     0     0>

            , <&key_physical_attrs 100 100  1000  117        0     0     0>
            , <&key_physical_attrs 100 100  1100  108        0     0     0>
            , <&key_physical_attrs 100 100  1200  100        0     0     0>
            , <&key_physical_attrs 100 100  1300  108        0     0     0>
            , <&key_physical_attrs 100 100  1400  121        0     0     0>
            , <&key_physical_attrs 100 100  1500  121        0     0     0>

            // Row 2, including inner key on each half
            , <&key_physical_attrs 100 100     0  221        0     0     0>
            , <&key_physical_attrs 100 100   100  221        0     0     0>
            , <&key_physical_attrs 100 100   200  208        0     0     0>
            , <&key_physical_attrs 100 100   300  200        0     0     0>
            , <&key_physical_attrs 100 100   400  208        0     0     0>
            , <&key_physical_attrs 100 100   500  217        0     0     0>
            , <&key_physical_attrs 100 100   617  233        0     0     0>

            , <&key_physical_attrs 100 100   883  233        0     0     0>
            , <&key_physical_attrs 100 100  1000  217        0     0     0>
            , <&key_physical_attrs 100 100  1100  208        0     0     0>
            , <&key_physical_attrs 100 100  1200  200        0     0     0>
            , <&key_physical_attrs 100 100  1300  208        0     0     0>
            , <&key_physical_attrs 100 100  1400  221        0     0     0>
            , <&key_physical_attrs 100 100  1500  221        0     0     0>

            // Modifier / thumb row
            , <&key_physical_attrs 100 100   276  329   (-500)   326   379>
            , <&key_physical_attrs 100 100   381  324         0     0     0>
            , <&key_physical_attrs 100 100   489  334      1000   539   384>
            , <&key_physical_attrs 100 100   595  362      2000   645   412>

            , <&key_physical_attrs 100 100   905  362   (-2000)   955   412>
            , <&key_physical_attrs 100 100  1011  334   (-1000)  1061   384>
            , <&key_physical_attrs 100 100  1119  324         0     0     0>
            , <&key_physical_attrs 100 100  1224  329       500  1274   379>
            ;
    };
};
