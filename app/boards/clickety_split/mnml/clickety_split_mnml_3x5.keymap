#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LX_MAIN     0 // Main
#define LX_LOWER    1 // Lower
#define LX_RAISE    2 // Raise
#define LX_ADJUST   3 // Adjust
#define LX_CONFIG   4 // Config

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        lower_raise_adjust {
            if-layers = <LX_LOWER LX_RAISE>;
            then-layer = <LX_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Leading space provides visual separation from the layer icon.
            // Layer references: 1 = Lower, 2 = Raise
            display-name = " Main";
            bindings = <
                &kp Q         &kp W         &kp E           &kp R         &kp T                                      &kp Y         &kp U        &kp I            &kp O         &kp P
                &kp A         &kp S         &kp D           &kp F         &kp G                                      &kp H         &kp J        &kp K            &kp L         &kp SEMI
                &mt LSFT Z    &kp X         &kp C           &kp V         &kp B         &kp ESC         &kp LCTRL    &kp N         &kp M        &kp COMMA        &kp DOT       &mt RSFT FSLH
                                            &kp LALT        &kp LGUI      &lt 1 RET     &lt 2 MINUS     &lt 2 EQUAL  &lt 1 SPACE   &kp BSPC     &mo LX_CONFIG
            >;
        };

        lower_layer {
            display-name = " Lower";
            bindings = <
                &kp N1        &kp N2        &kp N3          &kp N4        &kp N5                                     &kp N6        &kp N7        &kp N8          &kp N9        &kp N0
                &none         &kp LT        &kp LPAR        &kp LBKT      &kp LBRC                                   &kp RBRC      &kp RBKT      &kp RPAR        &kp GT        &kp QUOT
                &kp LSHFT     &none         &none           &none         &none         &trans          &trans       &none         &none         &none           &none         &kp RSHFT
                                            &trans          &trans        &trans        &trans          &trans       &trans        &trans        &trans
            >;
        };

        raise_layer {
            display-name = " Raise";
            bindings = <
                &kp TAB       &none         &none           &none         &none                                      &kp PG_UP     &kp HOME      &kp UP          &kp END       &kp BSLH
                &kp CAPS      &none         &none           &none         &none                                      &kp PG_DN     &kp LEFT      &kp DOWN        &kp RIGHT     &kp GRAVE
                &trans        &none         &none           &none         &none         &trans          &trans       &none         &none         &none           &none         &kp TILDE
                                            &trans          &trans        &trans        &trans          &trans       &trans        &kp DEL       &kp INS
            >;
        };

        adjust_layer {
            display-name = " Adjust";
            bindings = <
                &kp F1        &kp F2        &kp F3          &kp F4        &kp F5                                     &none         &none         &kp C_VOL_UP    &none         &kp PSCRN
                &kp F6        &kp F7        &kp F8          &kp F9        &kp F10                                    &none         &none         &kp C_VOL_DN    &none         &none
                &kp F11       &kp F12       &none           &none         &none         &trans          &trans       &none         &kp C_MUTE    &none           &none         &trans
                                            &trans          &trans        &trans        &trans          &trans       &trans        &trans        &trans
            >;
        };

        config_layer {
            display-name = " Config";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4                               &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
                &bootloader   &sys_reset    &studio_unlock  &none         &none                                      &none         &none         &studio_unlock  &sys_reset    &bootloader
                &trans        &bt BT_CLR    &out OUT_USB    &out OUT_BLE  &none         &trans          &trans       &none         &out OUT_BLE  &out OUT_USB    &bt BT_CLR    &trans
                                            &trans          &trans        &trans        &trans          &trans       &trans        &trans         &trans
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };

        extra5 {
            status = "reserved";
        };

    };
};