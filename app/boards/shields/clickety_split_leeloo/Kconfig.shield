config SHIELD_CLICKETY_SPLIT_LEELOO
    bool

config SHIELD_CLICKETY_SPLIT_LEELOO_LEFT
    def_bool $(shields_list_contains,clickety_split_leeloo_left)
    select SHIELD_CLICKETY_SPLIT_LEELOO

config SHIELD_CLICKETY_SPLIT_LEELOO_RIGHT
    def_bool $(shields_list_contains,clickety_split_leeloo_right)
    select SHIELD_CLICKETY_SPLIT_LEELOO

