/*
 * Copyright (c) 2026 Clickety Split Ltd.
 * SPDX-License-Identifier: MIT
 *
 * Leeloo v2.1/rev3 + Clickety Split Chiisai RGB integration.
 *
 * This controller-specific definition is owned by the Leeloo shield.
 * Chiisai remains a generic Pro Micro-compatible controller.
 *
 * Hardware arrangement:
 *
 *   Chiisai P0.06 active-high:
 *       Enables the onboard TPS79333-EP LDO. The resulting VCC rail powers
 *       the Sharp display and the source side of Leeloo's RGB MOSFET.
 *       P0.06 remains asserted during normal operation and ordinary idle,
 *       independently of RGB state, and is disabled before deep sleep.
 *
 *   Chiisai rear P0.08 active-low:
 *       Connect to the Leeloo RGB MOSFET gate with a bodge wire.
 *       ZMK EXT_POWER controls this GPIO.
 *
 *   Pro Micro TX0 / Arduino D1 / Chiisai P1.09:
 *       WS2812 SPI data output.
 *
 * P0.08 was selected after a source-level collision audit. P0.04 remains
 * available for possible future analog use, and P0.12 remains a spare.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,underglow = &led_strip;
    };

    /*
     * Override Chiisai's board-level EXT_POWER assignment.
     *
     * Generic Chiisai:
     *     P0.06 active-high -> onboard TPS79333-EP LDO enable
     *
     * Leeloo rev3 + Chiisai:
     *     P0.08 active-low -> keyboard RGB MOSFET gate
     */
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

        /*
         * Preserve Chiisai's established conservative enable delay.
         * Physical testing confirmed normal startup and RGB operation.
         * The 30-minute production sleep/wake test also passed.
         * Electrical rail waveforms were not oscilloscope-verified.
         */
        init-delay-ms = <50>;
    };
};

/*
 * The PM-aware GPIO rail keeps the Chiisai TPS79333-EP LDO enabled during
 * normal operation and ordinary idle so the display and MOSFET source
 * remain powered. Device PM disables the rail before deep sleep and
 * restores it on wake.
 */
/ {
    /*
     * Keep the Chiisai TPS79333-EP / VCC / display rail enabled during
     * normal operation and ordinary idle. Device PM disables P0.06 before
     * deep sleep so the attached Sharp Memory LCD supply can power down.
     *
     * RGB power remains independently switched through the active-low
     * Leeloo MOSFET gate on rear GPIO P0.08 via ZMK EXT_POWER.
     */
    leeloo_rev3_chiisai_vcc_rail: leeloo-rev3-chiisai-vcc-rail {
        compatible = "zmk,pm-gpio-rail";
        enable-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
        status = "okay";
    };
};

&pinctrl {
    leeloo_rev3_chiisai_spi3_default:
        leeloo_rev3_chiisai_spi3_default {
        group1 {
            /* Pro Micro TX0 / Arduino D1 maps to Chiisai P1.09. */
            psels = <NRF_PSEL(SPIM_MOSI, 1, 9)>;
        };
    };

    leeloo_rev3_chiisai_spi3_sleep:
        leeloo_rev3_chiisai_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 9)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&leeloo_rev3_chiisai_spi3_default>;
    pinctrl-1 = <&leeloo_rev3_chiisai_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        status = "okay";

        reg = <0>;
        spi-max-frequency = <4000000>;

        /* Leeloo v2.1/rev3 contains 29 GRB LEDs per half. */
        chain-length = <29>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <
            LED_COLOR_ID_GREEN
            LED_COLOR_ID_RED
            LED_COLOR_ID_BLUE
        >;
    };
};
