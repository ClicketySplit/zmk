 *
 * Leeloo v2.1/rev3 + Clickety Split Chiisai Sharp
 * memory-in-pixel display integration.
 *
 * This definition is owned by the Leeloo shield. Chiisai remains a generic
 * Pro Micro-compatible controller.
 *
 * No nice_view or nice_view_adapter shield is required.
 */

#include <dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zephyr,display = &leeloo_rev3_chiisai_mip;
    };
};

&pinctrl {
    leeloo_rev3_chiisai_spi0_default:
        leeloo_rev3_chiisai_spi0_default {
        group1 {
            /*
             * Leeloo rev3 display connector:
             *
             *   Pro Micro D3 / SCK  -> Chiisai P1.13
             *   Pro Micro D2 / MOSI -> Chiisai P1.12
             */
            psels = <
                NRF_PSEL(SPIM_SCK, 1, 13)
                NRF_PSEL(SPIM_MOSI, 1, 12)
            >;
        };
    };

    leeloo_rev3_chiisai_spi0_sleep:
        leeloo_rev3_chiisai_spi0_sleep {
        group1 {
            psels = <
                NRF_PSEL(SPIM_SCK, 1, 13)
                NRF_PSEL(SPIM_MOSI, 1, 12)
            >;
            low-power-enable;
        };
    };
};

/*
 * SPI0 and I2C0 are alternate personalities of nRF52840 peripheral zero.
 * Disable the inherited SSD1306 device and I2C0 before using SPI0.
 */
&oled {
    status = "disabled";
};

&pro_micro_i2c {
    status = "disabled";
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&leeloo_rev3_chiisai_spi0_default>;
    pinctrl-1 = <&leeloo_rev3_chiisai_spi0_sleep>;
    pinctrl-names = "default", "sleep";

    /*
     * Leeloo routes Sharp display chip select to Pro Micro D4.
     * Chiisai maps D4 to P1.14.
     */
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;

    leeloo_rev3_chiisai_mip: ls0xx@0 {
        compatible = "sharp,ls0xx";
        status = "okay";

        reg = <0>;
        spi-max-frequency = <1000000>;

        width = <160>;
        height = <68>;

        serial-vcom-inversion;
        serial-vcom-interval = <33>;
    };
};
